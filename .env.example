# Copy this file to ".env" and put your own PostgreSQL connection string.
# Local example (change YOUR_PASSWORD):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cabtrack
# Neon / cloud example (keep sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
